# Copy this file to .env and fill in your Advent of Code session cookie.
#
# How to get it:
#   1. Log in at https://adventofcode.com (GitHub login is fine — AoC only uses
#      GitHub to verify your identity, it never gets an API token from it).
#   2. Open your browser devtools -> Application/Storage -> Cookies
#      -> adventofcode.com -> copy the value of the cookie named "session".
#
# This value is a bearer credential for your AoC account — treat it like a
# password. Never commit the real .env file (it's gitignored).
AOC_SESSION_COOKIE=
